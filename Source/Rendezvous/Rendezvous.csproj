<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Version>1.0.0-beta.1</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>Rendezvous</RootNamespace>
    <AssemblyName>Rendezvous</AssemblyName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup><Compile Include="../Shared/OwnerProofBytes.cs" Link="Protocol/OwnerProofBytes.cs" /></ItemGroup>
  <ItemGroup><Compile Include="../Shared/BridgeMessages.cs" Link="Protocol/BridgeMessages.cs" /></ItemGroup>
  <ItemGroup><Compile Include="../Shared/OwnerEnrollmentProtocol.cs" Link="Protocol/OwnerEnrollmentProtocol.cs" /></ItemGroup>
  <!-- This program only does rendezvous. The browser-play web server and its page are built into the desktop client (Rendezvous.Embedded). -->
  <ItemGroup><Compile Remove="BridgeSignalingServer.cs;BridgeRtcBroker.cs;P2pIceConfiguration.cs;DesktopBrowserServer.cs;AcmeIpCertificate.cs" /></ItemGroup>

</Project>
