<Project Sdk="Microsoft.NET.Sdk.Web" TreatAsLocalProperty="AssemblyName">
  <PropertyGroup>
    <PublishIISAssets>false</PublishIISAssets>
    <OutputType>Library</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Version>1.0.0-beta.1</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Rendezvous</RootNamespace>
    <AssemblyName>Rendezvous.Embedded</AssemblyName>
    <PackageId>Rendezvous.Embedded</PackageId>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Rendezvous/*.cs" Exclude="../Rendezvous/Program.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="../Shared/OwnerProofBytes.cs;../Shared/BridgeMessages.cs;../Shared/BrowserJoinLink.cs;../Shared/OwnerEnrollmentProtocol.cs;../Shared/ViewerLimits.cs" Link="Protocol/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../Rendezvous/Web/**/*" Link="Web/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
